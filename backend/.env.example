# Database
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/financeai

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/v1/auth/google/callback

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct  # Llama 3.2 vision deprecated; use Llama 4 Scout (multimodal)

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=financeai_transactions

# Embeddings (fastembed ONNX model)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# App
FRONTEND_URL=https://yourdomain.com
ENVIRONMENT=production
LOG_LEVEL=INFO
