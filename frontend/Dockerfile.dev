FROM node:22-alpine

# Enable corepack and pin pnpm to match host version exactly (10.33.2 as of 2026-05-28).
# Avoids version drift: lockfile was generated by pnpm 10 (host), and pnpm 11 has stricter
# postinstall script policy that requires lockfile-recorded approval — using pnpm 10 here
# stays consistent with how user installs locally.
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

WORKDIR /app

# Install deps in image layer (NOT bind-mounted)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Source code di-bind mount via compose

EXPOSE 3000

CMD ["pnpm", "dev"]
